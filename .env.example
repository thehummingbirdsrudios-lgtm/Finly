# Finly environment template — NAMES ONLY. Never put a real value in this file or commit a filled copy.
# Real values live in a git-ignored `.env` (local development) or in the platform's secret store (CI, production).
# The final list is fixed when Gate 1 approves the stack; these are the variables the build specification already implies.

# Which environment this process runs in: development | staging | production
FINLY_ENV=

# Backend endpoint the app talks to (public URL, not a secret).
FINLY_API_BASE_URL=

# Public client key for the backend's auth gateway (publishable by design; still not committed).
FINLY_PUBLIC_CLIENT_KEY=

# Server-side only — never shipped in the app, never in CI logs.
# Key-encryption key reference for application-level encryption of financial values (BUILD_PROMPT Part M).
FINLY_KEK_REF=
# Database connection for the posting engine and migrations.
FINLY_DATABASE_URL=
