# Copy to .env.local (git-ignored) and fill in for your machine. Never commit real values.
# Admin connection to a local PostgreSQL 17 server; the database tests create and drop finly_t_* databases on it.
FINLY_PG17_ADMIN_URL=postgres://USER:PASSWORD@127.0.0.1:5435/postgres
# Optional: a PostgreSQL 18 server for a secondary compatibility run.
FINLY_PG18_ADMIN_URL=
