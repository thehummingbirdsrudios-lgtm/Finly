{
  "name": "@finly/backend",
  "version": "0.1.0",
  "exports": "./src/http/app.ts",
  "tasks": {
    "test": "deno test --allow-read --allow-env --allow-net=registry.npmjs.org,jsr.io tests/",
    "check": "deno check src/ tests/",
    "lint": "deno lint",
    "fmt-check": "deno fmt --check",
    "verify": "deno fmt --check && deno lint && deno check src/ tests/ db/tools/ && deno test --allow-read --allow-env tests/",
    "db:dictionary": "deno run --allow-read --allow-write=../docs/database --allow-env db/tools/dictionary.ts",
    "db:coa-seed": "deno run --allow-read db/tools/coa_seed_sql.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.13",
    "zod": "npm:zod@3.24.2",
    "jose": "npm:jose@5.10.0",
    "@noble/hashes/": "npm:/@noble/hashes@1.8.0/",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.8",
    "postgres": "npm:postgres@3.4.5"
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true,
    "include": ["src/", "tests/", "db/tools/"]
  },
  "lint": {
    "include": ["src/", "tests/", "db/tools/"],
    "rules": { "tags": ["recommended"] }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
